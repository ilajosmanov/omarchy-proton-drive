[Unit]
Description=Proton Drive for Omarchy background service
After=graphical-session-pre.target
PartOf=graphical-session.target

[Service]
Type=simple
UMask=0077
EnvironmentFile=-%E/omarchy-drive/environment
ExecStart=/usr/bin/bun /usr/lib/omarchy-drive/daemon/src/main.ts
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%C/omarchy-drive %S/omarchy-drive %C/proton-drive-cli %S/proton-drive-cli %h/.local/share/proton-drive-cli %t
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=graphical-session.target
