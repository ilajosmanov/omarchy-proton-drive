[Unit]
Description=Mount Proton Drive for Omarchy in Files
After=omarchy-drive.service
Requires=omarchy-drive.service
PartOf=graphical-session.target

[Service]
Type=simple
UMask=0077
Environment="OMARCHY_DRIVE_MOUNT=%h/.local/share/omarchy-drive/mount"
EnvironmentFile=-%E/omarchy-drive/environment
# Nautilus can keep the old FUSE endpoint open after logout.  Clean up a
# stale endpoint before starting a new session so login/retry can recover.
ExecStartPre=-/usr/bin/fusermount3 -uzq ${OMARCHY_DRIVE_MOUNT}
ExecStart=/usr/bin/python3 /usr/lib/omarchy-drive/filesystem/fuse/omarchy-drive-fuse.py ${OMARCHY_DRIVE_MOUNT} --socket %t/omarchy-drive.sock
ExecStop=-/usr/bin/fusermount3 -uzq ${OMARCHY_DRIVE_MOUNT}
Restart=on-failure
RestartSec=5
# FUSE must publish this mount in the user's host mount namespace.
PrivateTmp=no

[Install]
WantedBy=graphical-session.target
