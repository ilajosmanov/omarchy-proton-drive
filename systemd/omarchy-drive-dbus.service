[Unit]
Description=Proton Drive for Omarchy session D-Bus bridge
After=omarchy-drive.service
Requires=omarchy-drive.service
PartOf=graphical-session.target

[Service]
Type=simple
UMask=0077
Environment="OMARCHY_DRIVE_MOUNT=%h/.local/share/omarchy-drive/mount"
EnvironmentFile=-%E/omarchy-drive/environment
ExecStart=/usr/bin/python3 /usr/lib/omarchy-drive/ipc/dbus/omarchy_drive_dbus.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=graphical-session.target
